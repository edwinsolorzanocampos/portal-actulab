---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhatIs from '../components/WhatIs.astro';
import Guide from '../components/Guide.astro';
import Features from '../components/Features.astro';
import DashboardPreview from '../components/DashboardPreview.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Actulab - Gestiona tu negocio por WhatsApp" 
  description="Actulab permite a pequeños y medianos negocios administrar inventario, ventas, clientes y créditos enviando simples mensajes por WhatsApp."
>
  <Header />
  <main>
    <Hero />
    <WhatIs />
    <Guide />
    <Features />
    <DashboardPreview />
    <CTASection />
  </main>
  <Footer />
</Layout>
