---
const highlights = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.35 5L2 22l5.23-1.29A9.96 9.96 0 0012 22c5.52 0 10-4.48 10-10S17.52 2 12 2z" fill="currentColor"/></svg>`,
    title: 'Habla como siempre',
    description: 'No necesitas aprender comandos. Solo envías un mensaje de texto como lo harías con cualquier persona.'
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14h-2v-4H8v-2h2V9h2v2h2v2h-2v4z" fill="currentColor"/></svg>`,
    title: 'Actualización inmediata',
    description: 'La información se registra en el momento exacto en que ocurre cada operación, sin esperar hasta llegar a casa.'
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" fill="currentColor"/></svg>`,
    title: 'Tu información segura',
    description: 'Toda la información de tu negocio se organiza automáticamente y la puedes consultar cuando la necesites.'
  }
];
---

<section id="que-es" class="section whatis">
  <div class="container">
    <div class="whatis-grid">
      <div class="whatis-content reveal">
        <span class="section-label">¿Qué es Actulab?</span>
        <h2 class="whatis-title">
          La herramienta de gestión empresarial que <span class="gradient-text">habla tu idioma</span>.
        </h2>
        <p class="whatis-description">
          Actulab utiliza inteligencia artificial para simplificar la administración de pequeños y medianos negocios. 
          En lugar de formularios complicados, solo necesitas enviar un mensaje por WhatsApp para registrar ventas, 
          consultar inventario, revisar créditos y mucho más.
        </p>
        <p class="whatis-description">
          No importa si estás en tu local, en la calle o en casa: la información de tu negocio se actualiza 
          al instante, en el momento en que sucede cada operación.
        </p>
      </div>

      <div class="whatis-highlights">
        {highlights.map((item, index) => (
          <article class="highlight-card reveal" style={`transition-delay: ${index * 0.1}s`}>
            <div class="highlight-icon" set:html={item.icon} />
            <h3 class="highlight-title">{item.title}</h3>
            <p class="highlight-description">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .whatis {
    background-color: var(--color-surface);
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .whatis-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  .whatis-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .whatis-description {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .whatis-highlights {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .highlight-card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: white;
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .highlight-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-cyan-light));
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .highlight-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .highlight-description {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .whatis-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
