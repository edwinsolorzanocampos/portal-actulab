---
const team = [
  {
    initials: 'A',
    name: 'Administrador del sistema',
    role: 'Gestión de accesos y soporte técnico',
    color: '#2563eb'
  },
  {
    initials: 'D',
    name: 'Desarrollador principal',
    role: 'Arquitectura y evolución del producto',
    color: '#7c3aed'
  },
  {
    initials: 'U',
    name: 'Usuario piloto',
    role: 'Retroalimentación y mejora continua',
    color: '#06b6d4'
  }
];
---

<section id="equipo" class="section team">
  <div class="container">
    <h2 class="section-title">Quienes impulsan Actulab</h2>
    <p class="section-subtitle">
      Un equipo comprometido con construir herramientas útiles para tu negocio.
    </p>
    <div class="team-grid">
      {team.map(member => (
        <article class="team-card gradient-border">
          <div class="team-avatar" style={`background-color: ${member.color}`}>
            {member.initials}
          </div>
          <h3 class="team-name">{member.name}</h3>
          <p class="team-role">{member.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team {
    background-color: var(--color-bg);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem;
    border-radius: var(--radius);
    background: white;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .team-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    color: white;
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }

  .team-name {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
  }

  .team-role {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
</style>
