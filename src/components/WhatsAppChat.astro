---
interface Message {
  type: 'user' | 'bot';
  text: string;
}

interface Props {
  title?: string;
  status?: string;
  messages: Message[];
  class?: string;
}

const { 
  title = 'Actulab', 
  status = 'En línea', 
  messages = [],
  class: className = ''
} = Astro.props;
---

<div class={`whatsapp-chat ${className}`}>
  <div class="chat-header">
    <div class="chat-avatar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M12 2C6.48 2 2 6.48 2 12c0 1.82.49 3.53 1.35 5L2 22l5.23-1.29A9.96 9.96 0 0012 22c5.52 0 10-4.48 10-10S17.52 2 12 2z" fill="currentColor"/>
      </svg>
    </div>
    <div class="chat-info">
      <span class="chat-title">{title}</span>
      <span class="chat-status">{status}</span>
    </div>
  </div>
  <div class="chat-body">
    <div class="chat-date">Hoy</div>
    {messages.map((message, index) => (
      <div class={`chat-message ${message.type}`} style={`--delay: ${index * 0.15}s`}>
        <div class="chat-bubble">
          <p>{message.text}</p>
          <span class="chat-time">
            {message.type === 'bot' && (
              <span class="chat-check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" fill="currentColor"/>
                </svg>
              </span>
            )}
            {message.type === 'user' && '✓✓'}
            <span class="sr-only">{message.type === 'bot' ? 'Confirmado' : 'Enviado'}</span>
          </span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .whatsapp-chat {
    width: 100%;
    max-width: 22rem;
    border-radius: 1.75rem;
    overflow: hidden;
    background: #e5ddd5;
    box-shadow: var(--shadow-lg);
    border: 8px solid white;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: linear-gradient(180deg, #075e54, #128c7e);
    color: white;
  }

  .chat-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }

  .chat-info {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .chat-title {
    font-weight: 700;
    font-size: 1rem;
  }

  .chat-status {
    font-size: 0.75rem;
    opacity: 0.9;
  }

  .chat-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    min-height: 18rem;
    background: 
      radial-gradient(circle at 10% 20%, rgba(37, 99, 235, 0.03) 0%, transparent 20%),
      radial-gradient(circle at 90% 80%, rgba(124, 58, 237, 0.03) 0%, transparent 20%),
      #efeae2;
  }

  .chat-date {
    align-self: center;
    padding: 0.375rem 0.75rem;
    background: rgba(255, 255, 255, 0.65);
    border-radius: 9999px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .chat-message {
    display: flex;
    opacity: 0;
    transform: translateY(10px);
    animation: messageIn 0.5s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  .chat-message.user {
    justify-content: flex-end;
  }

  .chat-message.bot {
    justify-content: flex-start;
  }

  .chat-bubble {
    position: relative;
    max-width: 85%;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px rgba(0,0,0,0.08);
  }

  .chat-message.user .chat-bubble {
    background: var(--whatsapp-bubble);
    border-bottom-right-radius: 0.25rem;
    color: #111827;
  }

  .chat-message.bot .chat-bubble {
    background: white;
    border-bottom-left-radius: 0.25rem;
    color: var(--color-text);
  }

  .chat-bubble p {
    margin-bottom: 0.25rem;
  }

  .chat-time {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    font-size: 0.6875rem;
    color: #8b9aa6;
    float: right;
  }

  .chat-check {
    display: inline-flex;
    color: #34b7f1;
  }

  @keyframes messageIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .whatsapp-chat {
      max-width: 100%;
    }
  }
</style>
