---
---

<section class="section dashboard">
  <div class="container">
    <div class="dashboard-grid">
      <div class="dashboard-content reveal">
        <span class="section-label">Dashboard web</span>
        <h2 class="dashboard-title">
          Tu negocio, <span class="gradient-text">visual y organizado</span>.
        </h2>
        <p class="dashboard-description">
          Además de WhatsApp, cada negocio cuenta con un portal web donde puede visualizar su información 
          de manera clara y ordenada. Consulta indicadores, revisa tus ventas, controla tu inventario y 
          mantén al día tus créditos desde cualquier dispositivo.
        </p>
        <ul class="dashboard-list">
          <li>
            <span class="check-icon" aria-hidden="true">✓</span>
            Indicadores clave al instante
          </li>
          <li>
            <span class="check-icon" aria-hidden="true">✓</span>
            Historial de ventas y movimientos
          </li>
          <li>
            <span class="check-icon" aria-hidden="true">✓</span>
            Inventario y cuentas por cobrar
          </li>
        </ul>
      </div>

      <div class="dashboard-visual reveal">
        <div class="dashboard-window">
          <div class="window-header">
            <div class="window-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="window-title">Actulab Dashboard</span>
          </div>
          <div class="window-body">
            <div class="sidebar">
              <div class="sidebar-logo">
                <span class="logo-icon">A</span>
                <span>Actulab</span>
              </div>
              <nav class="sidebar-nav">
                <span class="nav-item active">Resumen</span>
                <span class="nav-item">Ventas</span>
                <span class="nav-item">Inventario</span>
                <span class="nav-item">Clientes</span>
                <span class="nav-item">Créditos</span>
              </nav>
            </div>
            <div class="main-content">
              <div class="kpi-grid">
                <div class="kpi-card">
                  <span class="kpi-label">Ventas del mes</span>
                  <span class="kpi-value">₡1.245.000</span>
                  <span class="kpi-trend positive">+12%</span>
                </div>
                <div class="kpi-card">
                  <span class="kpi-label">Productos</span>
                  <span class="kpi-value">142</span>
                  <span class="kpi-trend">en inventario</span>
                </div>
                <div class="kpi-card">
                  <span class="kpi-label">Créditos pendientes</span>
                  <span class="kpi-value">₡345.000</span>
                  <span class="kpi-trend alert">8 clientes</span>
                </div>
                <div class="kpi-card">
                  <span class="kpi-label">Clientes</span>
                  <span class="kpi-value">56</span>
                  <span class="kpi-trend">activos</span>
                </div>
              </div>
              <div class="charts-row">
                <div class="chart-card sales-chart">
                  <span class="chart-title">Ventas recientes</span>
                  <div class="bars">
                    <div class="bar" style="height: 45%"></div>
                    <div class="bar" style="height: 70%"></div>
                    <div class="bar" style="height: 55%"></div>
                    <div class="bar" style="height: 85%"></div>
                    <div class="bar" style="height: 60%"></div>
                    <div class="bar" style="height: 90%"></div>
                    <div class="bar" style="height: 75%"></div>
                  </div>
                </div>
                <div class="chart-card credit-table">
                  <span class="chart-title">Créditos por cobrar</span>
                  <div class="table-row">
                    <span>María L.</span>
                    <span class="amount">₡47.500</span>
                  </div>
                  <div class="table-row">
                    <span>Carlos R.</span>
                    <span class="amount">₡23.000</span>
                  </div>
                  <div class="table-row">
                    <span>Pedro G.</span>
                    <span class="amount">₡15.000</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dashboard {
    background-color: var(--color-bg);
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  .dashboard-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .dashboard-description {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .dashboard-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .dashboard-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-success-light);
    color: var(--color-success);
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .dashboard-visual {
    display: flex;
    justify-content: center;
  }

  .dashboard-window {
    width: 100%;
    max-width: 42rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: white;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-border);
  }

  .window-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .window-dots {
    display: flex;
    gap: 0.375rem;
  }

  .window-dots span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .window-dots span:nth-child(1) { background: #ef4444; }
  .window-dots span:nth-child(2) { background: #f59e0b; }
  .window-dots span:nth-child(3) { background: #10b981; }

  .window-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .window-body {
    display: grid;
    grid-template-columns: 7rem 1fr;
    min-height: 20rem;
  }

  .sidebar {
    background: var(--color-surface);
    border-right: 1px solid var(--color-border);
    padding: 1rem 0.75rem;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    font-size: 0.75rem;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-item {
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .nav-item.active {
    background: white;
    color: var(--color-primary);
    box-shadow: var(--shadow);
  }

  .main-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .kpi-card {
    padding: 0.875rem;
    border-radius: 0.625rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .kpi-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 600;
  }

  .kpi-value {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-text);
  }

  .kpi-trend {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .kpi-trend.positive {
    color: var(--color-success);
  }

  .kpi-trend.alert {
    color: #f59e0b;
  }

  .charts-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .chart-card {
    padding: 0.875rem;
    border-radius: 0.625rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .chart-title {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.375rem;
    height: 5rem;
  }

  .bar {
    flex: 1;
    border-radius: 0.25rem 0.25rem 0 0;
    background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
    opacity: 0.85;
  }

  .table-row {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    font-size: 0.8125rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .table-row .amount {
    font-weight: 700;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .dashboard-grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
    }

    .charts-row {
      grid-template-columns: 1fr 1fr;
    }

    .kpi-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 480px) {
    .window-body {
      grid-template-columns: 1fr;
    }

    .sidebar {
      display: none;
    }

    .kpi-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
